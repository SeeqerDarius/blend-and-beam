NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for the Paystack webhook and for Staff > invite-by-email (unset =
# the Staff page grants existing accounts but reports invites as unavailable).
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Also required for Staff > invite-by-email: SUPABASE_SERVICE_ROLE_KEY creates
# the pending account, RESEND_API_KEY actually delivers the invite email.
# RESEND_FROM_EMAIL needs a domain verified in Resend; unset uses the verified
# Blend & Beam sender address. Set a different sender only after verifying its domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Blend & Beam <team@blendandbeam.com>
